{
  "id": "glasshouse",
  "name": "Glasshouse",
  "version": "1.0.0",
  "author": "MixMusic",
  "description": "White glass and a rose-red accent, frosted over the colours of the cover.",
  "scheme": "light",
  "colors": {
    "bg": "#f5f5f7",
    "surface": "rgba(255, 255, 255, 0.62)",
    "surface-2": "rgba(255, 255, 255, 0.86)",
    "surface-3": "#e2e2e7",
    "border": "rgba(0, 0, 0, 0.08)",
    "text": "#1d1d1f",
    "text-muted": "#6e6e73",
    "accent": "#e11d48",
    "accent-text": "#ffffff",
    "danger": "#d70015",
    "success": "#248a3d",
    "youtube": "#e5332a",
    "spotify": "#18a148",
    "tile-1": "#e11d48",
    "tile-2": "#7c3aed",
    "tile-3": "#0369a1",
    "tile-4": "#0f766e",
    "tile-text": "#ffffff"
  },
  "fonts": {
    "body": "'SF Pro Text', 'Segoe UI Variable Text', -apple-system, 'Segoe UI', sans-serif",
    "display": "'SF Pro Display', 'Segoe UI Variable Display', -apple-system, 'Segoe UI', sans-serif"
  },
  "radius": "14px",
  "options": [
    {
      "id": "cover",
      "label": "Colours of the cover",
      "type": "toggle",
      "default": "true"
    },
    {
      "id": "blur",
      "label": "Glass blur",
      "type": "range",
      "default": "20",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px"
    }
  ]
}
