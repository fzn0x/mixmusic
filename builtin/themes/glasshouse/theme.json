{
  "id": "glasshouse",
  "name": "Glasshouse",
  "version": "1.0.0",
  "author": "MixMusic",
  "description": "White glass and a rose-red accent, frosted over the colours of the cover.",
  "scheme": "light",
  "colors": {
    "bg": "#f8f2f4",
    "surface": "rgba(255, 255, 255, 0.62)",
    "surface-2": "rgba(255, 255, 255, 0.86)",
    "surface-3": "#e7dfe2",
    "border": "rgba(60, 20, 35, 0.09)",
    "text": "#1f191b",
    "text-muted": "#6a6064",
    "accent": "#e11d48",
    "accent-text": "#ffffff",
    "danger": "#c5371b",
    "success": "#1b794a",
    "youtube": "#e5332a",
    "spotify": "#18a148",
    "tile-1": "#e11d48",
    "tile-2": "#7c3aed",
    "tile-3": "#0369a1",
    "tile-4": "#0f766e",
    "tile-text": "#ffffff"
  },
  "fonts": {
    "body": "'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif",
    "display": "'Segoe UI Variable Display', 'Segoe UI', system-ui, sans-serif"
  },
  "radius": "14px",
  "options": [
    {
      "id": "cover",
      "label": "Colours of the cover",
      "type": "toggle",
      "default": "true"
    },
    {
      "id": "blur",
      "label": "Glass blur",
      "type": "range",
      "default": "20",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px"
    }
  ]
}
