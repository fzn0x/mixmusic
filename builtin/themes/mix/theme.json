{
  "id": "mix",
  "name": "Mix",
  "version": "1.0.0",
  "author": "MixMusic",
  "description": "The default: flat colour tiles and giant lowercase on true black, with cyan for everything live.",
  "scheme": "dark",
  "colors": {
    "bg": "#000000",
    "surface": "#0b0b0b",
    "surface-2": "#181818",
    "surface-3": "#272727",
    "border": "rgba(255, 255, 255, 0.16)",
    "text": "#ffffff",
    "text-muted": "#a3a3a3",
    "accent": "#00bde3",
    "accent-text": "#000000",
    "danger": "#ff5a4f",
    "success": "#a4e600",
    "youtube": "#ff4040",
    "spotify": "#1ed760",
    "tile-1": "#00bde3",
    "tile-2": "#e6007e",
    "tile-3": "#a4e600",
    "tile-4": "#ffb000",
    "tile-text": "#000000"
  },
  "fonts": {
    "body": "Selawik, 'Segoe UI', 'Noto Sans', 'DejaVu Sans', system-ui, sans-serif",
    "display": "Selawik, 'Segoe UI', 'Noto Sans', 'DejaVu Sans', system-ui, sans-serif"
  },
  "radius": "0px",
  "options": [
    {
      "id": "texture",
      "label": "Tile texture",
      "type": "select",
      "default": "dots",
      "choices": [
        { "value": "dots", "label": "Dot matrix" },
        { "value": "stripes", "label": "Pinstripes" },
        { "value": "slashes", "label": "Slashes" },
        { "value": "none", "label": "None" }
      ]
    },
    { "id": "white-tiles", "label": "White text on tiles", "type": "toggle", "default": "false" }
  ]
}
