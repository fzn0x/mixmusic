{
  "id": "neon-nights",
  "name": "Neon Nights",
  "version": "1.0.0",
  "author": "MixMusic community",
  "description": "Electric magenta and violet tiles on deep indigo, with an optional neon edge on what is live.",
  "scheme": "dark",
  "colors": {
    "bg": "#0b0618",
    "surface": "#120a24",
    "surface-2": "#1b1033",
    "surface-3": "#281847",
    "border": "rgba(214, 160, 255, 0.16)",
    "text": "#f6efff",
    "text-muted": "#b4a3d6",
    "accent": "#ff3ea5",
    "accent-text": "#14000b",
    "danger": "#ff5b6e",
    "success": "#5cf2c5",
    "youtube": "#ff5b6e",
    "spotify": "#5cf2a0",
    "tile-1": "#ff3ea5",
    "tile-2": "#8a5cff",
    "tile-3": "#22d3ee",
    "tile-4": "#ffd23e",
    "tile-text": "#0b0618"
  },
  "fonts": {
    "body": "Selawik, 'Segoe UI', 'Noto Sans', system-ui, sans-serif",
    "display": "Selawik, 'Segoe UI', 'Noto Sans', system-ui, sans-serif"
  },
  "radius": "4px",
  "styles": "theme.css",
  "options": [
    { "id": "edge", "label": "Neon edge on live items", "type": "toggle", "default": "true" },
    { "id": "edge-size", "label": "Edge size", "type": "range", "default": "10", "min": 0, "max": 24, "step": 2, "unit": "px" }
  ],
  "files": ["theme.json", "theme.css"]
}
